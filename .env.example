# ─────────────────────────────────────────────────────────────
# Visit tracking: emails you when someone opens the demo.
# Sent through your Titan mailbox (smtp.titan.email).
# Copy to .env.local for local use, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Titan SMTP (defaults shown are Titan's standard SSL settings)
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_SECURE=true
# Full Titan mailbox address, e.g. you@yourdomain.com
TITAN_SMTP_USER=
# Titan mailbox password
TITAN_SMTP_PASS=

# Where visit notifications are delivered (any inbox)
TRACK_EMAIL_TO=
# Optional sender address; defaults to TITAN_SMTP_USER. Must be that mailbox or one of its aliases.
TRACK_EMAIL_FROM=
TRACK_EMAIL_FROM_NAME=ClassPano Demo Tracker
# Time zone used for the "When" line in emails, e.g. Asia/Karachi or America/New_York
TRACK_TIMEZONE=UTC

# Public URL of the deployed demo (used for links inside the emails)
NEXT_PUBLIC_SITE_URL=

# Switches. Set to false to turn tracking off.
TRACKING_ENABLED=true
NEXT_PUBLIC_TRACKING_ENABLED=true
